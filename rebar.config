{erl_opts, [debug_info]}.

{deps,
 [{resource_discovery,
   {git, "https://github.com/djani2703/resource_discovery.git", {branch, "main"}}}]}.

{project_plugins, [rebar3_format]}.

{relx,
 [{release, {simple_cache, "1.0.0"}, [simple_cache]},
  {dev_mode, false},
  {include_erts, false},
  {extended_start_script, true}]}.

{shell, [{config, "config/sys.config"}, {apps, [simple_cache]}]}.
